on init
    # Create a more standard /dev/block layout for our scripts
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    mkdir /mnt/vendor/persist 0775 shell system
    chown system system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon /mnt/vendor/persist
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw
    mount ext4 /dev/block/by-name/persist /persist rw
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/t6 0771 system system
    mount tmpfs tmpfs /data/vendor/t6 mode=0771,uid=1000,gid=1000
    mkdir /data/vendor/t6/app 0771 system system
    mkdir /data/vendor/t6/fs 0771 system system
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop crypto.ready 1

on fs && property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

# We need vold early for metadata encryption
on early-fs
    start vold

on fs
    install_keyring
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice
    mkdir /mnt/vendor/protect_f 0770 system system
    mkdir /mnt/vendor/protect_s 0770 system system
    mkdir /mnt/vendor/nvdata    0771 system system
    mkdir /mnt/vendor/nvcfg     0771 system system
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f rw wait
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s rw wait
    mount ext4 /dev/block/by-name/nvdata   /mnt/vendor/nvdata    rw wait
    mount ext4 /dev/block/by-name/nvcfg    /mnt/vendor/nvcfg     rw wait
    mkdir /mnt/vendor/persist/t6_rec    0755 system system
    mkdir /mnt/vendor/protect_f/tee_rec 0755 system system
    exec u:r:recovery:s0 system -- /vendor/bin/teed-init.sh

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6789 --late

on post-fs
    mkdir /data/vendor/key_provisioning 0771 system system
    start boot-hal-1-2

   write /proc/bootprof "crypto: start vendor.keymint"
    start vendor.keymint-trustkernel

on property:crypto.ready=1
    start vendor.keymint-trustkernel

on property:hwservicemanager.ready=true
    start vendor.gatekeeper-1-0
    start vendor.keymint-trustkernel

on property:vendor.sys.listener.registered=true
    start vendor.gatekeeper-1-0
    start vendor.keymint-trustkernel

on property:ro.crypto.state=unsupported
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel

on property:ro.crypto.state=unencrypted
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel

on property:twrp.decrypt.done=true && twrp.all.users.decrypted=true
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymint-trustkernel

on boot
    start health-hal-2-1
    setprop sys.usb.config adb
